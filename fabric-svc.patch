+//! Resource-free harness for the actual relay and transport router.
+use std::io::{self, BufRead, Write};
+use voicechat_server_relay::{
+    Config, Player,
+    bridge::{Bridge, Transport, registration},
+};
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+fn bytes(text: &str) -> Vec<u8> {
+    if text == "-" {
+        return Vec::new();
+    }
+    text.as_bytes()
+        .chunks(2)
+        .map(|b| u8::from_str_radix(std::str::from_utf8(b).unwrap(), 16).unwrap())
+        .collect()
+}
+fn main() {
+    let mut relay = Bridge::start(Config {
+        bind: "127.0.0.1".into(),
+        port: 0,
+        keep_alive_ms: 1000,
+        ..Config::default()
+    })
+    .unwrap();
+    let mut players: Vec<Player> = (1..=6)
+        .map(|id| Player {
+            uuid: id,
+            name: format!("player{id}"),
+            dimension: if id == 4 {
+                "minecraft:the_nether".into()
+            } else {
+                "minecraft:overworld".into()
+            },
+            position: [if id == 3 { 500.0 } else { id as f64 * 2.0 }, 64.0, 0.0],
+        })
+        .collect();
+    relay.tick(players.clone());
+    println!("REGISTER\t{}", hex(&registration()));
+    io::stdout().flush().unwrap();
+    for line in io::stdin().lock().lines() {
+        let line = line.unwrap();
+        let args: Vec<_> = line.split('\t').collect();
+        match args[0] {
+            "MSG" => relay.message(
+                args[1].parse().unwrap(),
+                args[2],
+                &bytes(args[3]),
+                if args[4] == "fabric" {
+                    Transport::Fabric
+                } else {
+                    Transport::Horizon
+                },
+            ),
+            "MOVE" => {
+                let id = args[1].parse::<u128>().unwrap();
+                let p = players.iter_mut().find(|p| p.uuid == id).unwrap();
+                p.position[0] = args[2].parse().unwrap();
+                p.dimension = args[3].into();
+            }
+            "LEFT" => {
+                let id = args[1].parse::<u128>().unwrap();
+                players.retain(|p| p.uuid != id);
+                relay.left(id);
+            }
+            "TICK" => {}
+            "QUIT" => break,
+            _ => panic!("unknown probe command"),
+        }
+        relay.tick(players.clone());
+        for (via, (player, channel, data)) in relay.outgoing(24) {
+            println!(
+                "OUT\t{player}\t{channel}\t{}\t{}",
+                hex(&data),
+                if via == Transport::Fabric {
+                    "fabric"
+                } else {
+                    "horizon"
+                }
+            );
+        }
+        println!("END");
+        io::stdout().flush().unwrap();
+    }
+}
