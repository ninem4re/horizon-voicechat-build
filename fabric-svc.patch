@@ -0,0 +1,126 @@
+//! SVC 2.6 (compatibility 20) over Fabric plugin channels or Horizon messages.
+use crate::{Config, Message, Player, Server, proto};
+use std::collections::HashMap;
+use std::io;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Transport {
+    Horizon,
+    Fabric,
+}
+
+pub const CHANNELS: &[&str] = &[
+    proto::REQUEST_SECRET,
+    proto::UPDATE_STATE,
+    proto::CREATE_GROUP,
+    proto::SET_GROUP,
+    proto::LEAVE_GROUP,
+];
+pub fn registration() -> Vec<u8> {
+    CHANNELS.join("\0").into_bytes()
+}
+pub fn valid_secret_request(channel: &str, data: &[u8]) -> bool {
+    channel == proto::REQUEST_SECRET && data == proto::COMPATIBILITY_VERSION.to_be_bytes()
+}
+pub struct Bridge {
+    server: Server,
+    routes: HashMap<u128, Transport>,
+}
+impl Bridge {
+    pub fn start(config: Config) -> io::Result<Self> {
+        Ok(Self {
+            server: Server::start(config)?,
+            routes: HashMap::new(),
+        })
+    }
+    pub fn tick(&mut self, players: Vec<Player>) {
+        self.routes
+            .retain(|id, _| players.iter().any(|p| p.uuid == *id));
+        self.server.tick(players);
+    }
+    pub fn knows(&self, player: u128) -> bool {
+        self.server.knows(player)
+    }
+    /// Only a game player with a valid protocol-20 request can select a route.
+    /// All subsequent messages must use the same transport as the secret request.
+    pub fn message(&mut self, player: u128, channel: &str, data: &[u8], via: Transport) {
+        if !self.server.knows(player) || !CHANNELS.contains(&channel) {
+            return;
+        }
+        if channel == proto::REQUEST_SECRET {
+            if !valid_secret_request(channel, data) {
+                return;
+            }
+            self.routes.insert(player, via);
+        } else if self.routes.get(&player) != Some(&via) {
+            return;
+        }
+        self.server.message(player, channel, data);
+    }
+    pub fn outgoing(&self, per_player: usize) -> Vec<(Transport, Message)> {
+        self.server
+            .outgoing(per_player)
+            .into_iter()
+            .filter_map(|m| self.routes.get(&m.0).copied().map(|via| (via, m)))
+            .collect()
+    }
+    pub fn left(&mut self, player: u128) {
+        self.routes.remove(&player);
+        self.server.left(player);
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn player() -> Player {
+        Player {
+            uuid: 1,
+            name: "test".into(),
+            dimension: "minecraft:overworld".into(),
+            position: [0.0, 64.0, 0.0],
+        }
+    }
+    fn bridge() -> Bridge {
+        let mut b = Bridge::start(Config {
+            bind: "127.0.0.1".into(),
+            port: 0,
+            ..Config::default()
+        })
+        .unwrap();
+        b.tick(vec![player()]);
+        b
+    }
+    #[test]
+    fn fabric_gets_raw_channels_and_horizon_keeps_its_envelope() {
+        for via in [Transport::Fabric, Transport::Horizon] {
+            let mut b = bridge();
+            b.message(1, proto::REQUEST_SECRET, &[0, 0, 0, 20], via);
+            let out = b.outgoing(24);
+            assert!(
+                out.iter()
+                    .any(|(t, m)| *t == via && m.1 == "voicechat:secret")
+            );
+            assert!(out.iter().all(|(t, m)| *t == via && m.0 == 1));
+        }
+    }
+    #[test]
+    fn unsupported_malformed_and_non_player_requests_get_no_secrets() {
+        let mut b = bridge();
+        for bytes in [&[0, 0, 0, 21][..], &[0, 0, 0], &[0, 0, 0, 20, 0]] {
+            b.message(1, proto::REQUEST_SECRET, bytes, Transport::Fabric);
+        }
+        b.message(2, proto::REQUEST_SECRET, &[0, 0, 0, 20], Transport::Fabric);
+        assert!(b.outgoing(24).is_empty());
+        assert!(b.routes.is_empty());
+    }
+    #[test]
+    fn logout_drops_routes_and_unhandshaken_messages_are_ignored() {
+        let mut b = bridge();
+        b.message(1, proto::UPDATE_STATE, &[1], Transport::Fabric);
+        assert!(b.outgoing(24).is_empty());
+        b.message(1, proto::REQUEST_SECRET, &[0, 0, 0, 20], Transport::Fabric);
+        assert!(!b.outgoing(24).is_empty());
+        b.left(1);
+        assert!(!b.routes.contains_key(&1));
+    }
+}
