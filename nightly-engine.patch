new file mode 100644
index 0000000..f2c622b
--- /dev/null
+++ b/crates/horizon-client/src/game/voicechat_server.rs
@@ -0,0 +1,171 @@
+// Standard SVC 2.6.x plugin channels, retaining Horizon clients.
+use crate::game::Game;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+use voicechat_server_relay::{
+    Config, Player,
+    bridge::{Bridge, Transport, registration, valid_secret_request},
+};
+const PER_TICK: usize = 24;
+const FILE: &str = "voicechat-server.json";
+const RETRY: Duration = Duration::from_secs(60);
+enum Relay {
+    Off,
+    Running(Bridge),
+    Failed(Instant),
+}
+static RELAY: Mutex<Relay> = Mutex::new(Relay::Off);
+fn relay() -> std::sync::MutexGuard<'static, Relay> {
+    RELAY.lock().unwrap_or_else(|e| e.into_inner())
+}
+fn players(game: &Game<'_>) -> Vec<Player> {
+    game.lan.as_ref().into_iter().flat_map(|h| h.hub.online_players())
+        .map(|p| Player {
+            uuid: p.uuid,
+            name: p.name.clone(),
+            dimension: p.dimension.clone(),
+            position: p.position,
+        })
+        .collect()
+}
+fn config() -> Config {
+    let Ok(dir) = Game::native_config_dir() else {
+        return Config::default();
+    };
+    let path = dir.join(FILE);
+    let config = match std::fs::read_to_string(&path) {
+        Ok(text) => match serde_json::from_str::<Config>(&text) {
+            Ok(c) => c,
+            Err(e) => {
+                log::warn!(
+                    "Voice chat: {} doesn't read ({e}); using defaults",
+                    path.display()
+                );
+                return Config::default();
+            }
+        },
+        Err(_) => Config::default(),
+    };
+    if let Ok(text) = serde_json::to_string_pretty(&config) {
+        let _ = std::fs::write(&path, text + "\n");
+    }
+    config
+}
+pub(super) fn advertise(game: &mut Game<'_>, player: u128) {
+    if config().enabled {
+        if let Err(e) =
+            send(game, player, "minecraft:register", &registration())
+        {
+            log::debug!("Voice chat: channel registration not sent: {e}");
+        }
+    }
+}
+pub(super) fn message(game: &mut Game<'_>, player: u128, channel: &str, data: &[u8]) {
+    receive(game, player, channel, data, Transport::Horizon);
+}
+pub(super) fn plugin_message(game: &mut Game<'_>, player: u128, channel: &str, data: &[u8]) {
+    receive(game, player, channel, data, Transport::Fabric);
+}
+fn receive(game: &mut Game<'_>, player: u128, channel: &str, data: &[u8], via: Transport) {
+    if !channel.starts_with("voicechat:") {
+        return;
+    }
+    let mut relay = relay();
+    if !matches!(*relay, Relay::Running(_)) {
+        if !valid_secret_request(channel, data) {
+            return;
+        }
+        let on = players(game);
+        if !on.iter().any(|p| p.uuid == player) {
+            return;
+        }
+        if let Relay::Failed(at) = *relay
+            && at.elapsed() < RETRY
+        {
+            return;
+        }
+        let config = config();
+        match Bridge::start(config.clone()) {
+            Ok(mut server) => {
+                server.tick(on);
+                log::info!(
+                    "Voice chat: SVC 2.6.x plugin channels ready on UDP {}:{}",
+                    config.bind,
+                    config.port
+                );
+                *relay = Relay::Running(server);
+            }
+            Err(e) => {
+                log::warn!(
+                    "Voice chat: not started on UDP {}:{}: {e}",
+                    config.bind,
+                    config.port
+                );
+                *relay = Relay::Failed(Instant::now());
+                return;
+            }
+        }
+    }
+    let Relay::Running(server) = &mut *relay else {
+        return;
+    };
+    if !server.knows(player) {
+        server.tick(players(game));
+    }
+    server.message(player, channel, data, via);
+}
+pub(super) fn tick(game: &mut Game<'_>) {
+    let out = {
+        let mut relay = relay();
+        let Relay::Running(server) = &mut *relay else {
+            return;
+        };
+        server.tick(players(game));
+        server.outgoing(PER_TICK)
+    };
+    for (via, (player, channel, data)) in out {
+        let result = match via {
+            Transport::Fabric => send(game, player, &channel, &data),
+            Transport::Horizon => send_legacy(game, player, &channel, &data),
+        };
+        if let Err(e) = result {
+            log::debug!("Voice chat: {channel} not sent: {e}");
+        }
+    }
+}
+pub(super) fn left(player: u128) {
+    if let Relay::Running(server) = &mut *relay() {
+        server.left(player);
+    }
+}
+pub(super) fn stop() {
+    *relay() = Relay::Off;
+}
+
+fn send(game: &Game<'_>, player: u128, channel: &str, data: &[u8]) -> Result<(), &'static str> {
+    let guest = game.lan.as_ref().and_then(|h| h.hub.online_players().find(|g| g.uuid == player))
+        .ok_or("player left")?;
+    guest.send(&horizon_protocol::packets::play::Clientbound::CustomPayload(
+        horizon_protocol::packets::configuration::CustomPayload {
+            channel: channel.to_owned(), data: data.to_vec(),
+        }));
+    Ok(())
+}
+fn send_legacy(game: &Game<'_>, player: u128, channel: &str, data: &[u8]) -> Result<(), &'static str> {
+    let mut out = horizon_protocol::buf::Writer::new();
+    out.string(channel);
+    out.byte_array(data);
+    send(game, player, "horizon:mod_net", &out.data)
+}
+pub(super) fn incoming(game: &mut Game<'_>, conn: u32, channel: &str, data: &[u8]) {
+    let Some(uuid) = game.lan.as_ref().and_then(|h| h.hub.guest(conn)).map(|g| g.uuid) else { return };
+    if channel == "horizon:mod_net" {
+        let mut reader = horizon_protocol::buf::Reader::new(data);
+        if let (Ok(channel), Ok(data)) = (reader.string(129), reader.byte_array(30_000))
+            && reader.remaining() == 0 {
+            message(game, uuid, &channel, &data);
+        }
+    } else {
+        plugin_message(game, uuid, channel, data);
+    }
+}
