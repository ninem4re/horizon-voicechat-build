new file mode 100644
index 0000000..bfc3544
--- /dev/null
+++ b/crates/horizon-skins-restorer/src/lib.rs
@@ -0,0 +1,136 @@
+//! Signed Mojang skins with persistent choices. Called only on login worker threads.
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+use std::io::{self, Read};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+pub struct Skin {
+    pub name: String,
+    pub value: String,
+    pub signature: String,
+}
+#[derive(Default, Deserialize, Serialize)]
+struct Choices(HashMap<String, String>);
+static STORAGE: Mutex<()> = Mutex::new(());
+type Cached = HashMap<String, (Instant, Option<Skin>)>;
+static CACHE: OnceLock<Mutex<Cached>> = OnceLock::new();
+static LOOKUPS: Mutex<usize> = Mutex::new(0);
+
+pub fn valid_name(name: &str) -> bool {
+    (3..=16).contains(&name.len()) && name.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_')
+}
+fn read_choices(path: &Path) -> io::Result<Choices> {
+    match std::fs::read(path) {
+        Ok(bytes) => serde_json::from_slice(&bytes).map_err(io::Error::other),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(Choices::default()),
+        Err(e) => Err(e),
+    }
+}
+fn file() -> PathBuf { PathBuf::from("config/skins-restorer.json") }
+pub fn select(player: u128, name: Option<&str>) -> io::Result<()> {
+    save_choice(&file(), player, name)
+}
+fn save_choice(path: &Path, player: u128, name: Option<&str>) -> io::Result<()> {
+    if name.is_some_and(|n| !valid_name(n)) {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "Invalid Minecraft account name"));
+    }
+    let _lock = STORAGE.lock().unwrap_or_else(|e| e.into_inner());
+    let mut choices = read_choices(path)?;
+    let key = format!("{player:032x}");
+    if let Some(name) = name { choices.0.insert(key, name.to_owned()); }
+    else { choices.0.remove(&key); }
+    std::fs::create_dir_all(path.parent().unwrap_or(Path::new(".")))?;
+    let temporary = path.with_extension("json.tmp");
+    let result = (|| {
+        use std::io::Write;
+        let mut output = std::fs::File::create(&temporary)?;
+        output.write_all(&serde_json::to_vec_pretty(&choices).map_err(io::Error::other)?)?;
+        output.sync_all()?;
+        std::fs::rename(&temporary, path)
+    })();
+    if result.is_err() { let _ = std::fs::remove_file(temporary); }
+    result
+}
+pub fn restore(player: u128, account: &str, has_skin: bool) -> Option<Skin> {
+    let selected = {
+        let _lock = STORAGE.lock().unwrap_or_else(|e| e.into_inner());
+        read_choices(&file()).ok()?.0.get(&format!("{player:032x}")).cloned()
+    };
+    let name = match selected {
+        Some(name) => name,
+        None if has_skin => return None,
+        None => account.to_owned(),
+    };
+    lookup(&name)
+}
+fn lookup(name: &str) -> Option<Skin> {
+    if !valid_name(name) { return None; }
+    let key = name.to_ascii_lowercase();
+    let cache = CACHE.get_or_init(|| Mutex::new(HashMap::new()));
+    if let Some((at, skin)) = cache.lock().unwrap_or_else(|e| e.into_inner()).get(&key)
+        && at.elapsed() < Duration::from_secs(900) {
+        return skin.clone();
+    }
+    {
+        let mut active = LOOKUPS.lock().unwrap_or_else(|e| e.into_inner());
+        if *active >= 8 { return None; }
+        *active += 1;
+    }
+    struct Permit;
+    impl Drop for Permit {
+        fn drop(&mut self) { *LOOKUPS.lock().unwrap_or_else(|e| e.into_inner()) -= 1; }
+    }
+    let _permit = Permit;
+    let agent = ureq::AgentBuilder::new().timeout(Duration::from_secs(3)).build();
+    let get = |url: &str| -> Option<serde_json::Value> {
+        let response = agent.get(url).call().ok()?;
+        let mut bytes = Vec::new();
+        response.into_reader().take(32_769).read_to_end(&mut bytes).ok()?;
+        if bytes.len() > 32_768 { return None; }
+        serde_json::from_slice(&bytes).ok()
+    };
+    let profile = get(&format!("https://api.minecraftservices.com/minecraft/profile/lookup/name/{key}"))?;
+    let id = profile["id"].as_str()?;
+    if id.len() != 32 || !id.bytes().all(|b| b.is_ascii_hexdigit()) { return None; }
+    let skin = get(&format!("https://sessionserver.mojang.com/session/minecraft/profile/{id}?unsigned=false"))?;
+    let result = signed_texture(&skin);
+    let mut entries = cache.lock().unwrap_or_else(|e| e.into_inner());
+    if entries.len() >= 1024 { entries.retain(|_, (at, _)| at.elapsed() < Duration::from_secs(900)); }
+    if entries.len() < 1024 { entries.insert(key, (Instant::now(), result.clone())); }
+    result
+}
+fn signed_texture(profile: &serde_json::Value) -> Option<Skin> {
+    for property in profile["properties"].as_array()? {
+        if property["name"].as_str() != Some("textures") { continue; }
+        let skin: Skin = serde_json::from_value(property.clone()).ok()?;
+        if !skin.value.is_empty() && !skin.signature.is_empty()
+            && skin.value.len() <= 8192 && skin.signature.len() <= 4096 { return Some(skin); }
+    }
+    None
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn signed_skins_and_persistent_choices() {
+        assert!(valid_name("MHF_Steve"));
+        assert!(!valid_name("../other"));
+        assert!(signed_texture(&serde_json::json!({"properties":[{"name":"textures", "value":"data"}]})).is_none());
+        let skin = signed_texture(&serde_json::json!({"properties":[{"name":"textures", "value":"data", "signature":"signed"}]})).unwrap();
+        assert_eq!(skin.signature, "signed");
+        let dir = std::env::temp_dir().join(format!("skin-choice-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("choices.json");
+        save_choice(&path, 42, Some("MHF_Steve")).unwrap();
+        assert_eq!(read_choices(&path).unwrap().0[&format!("{:032x}", 42)], "MHF_Steve");
+        save_choice(&path, 42, None).unwrap();
+        assert!(read_choices(&path).unwrap().0.is_empty());
+        std::fs::write(&path, "broken").unwrap();
+        assert!(save_choice(&path, 42, Some("MHF_Steve")).is_err());
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "broken");
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
